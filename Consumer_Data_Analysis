warnings.filterwarnings("ignore")

# ══════════════════════════════════════════════════════════════════════════════
# CONSUMER-DRIVEN MACRO SIGNAL — DYNAMIC PORTFOLIO STRATEGY
# Theory: Discretionary vs Staples spending shifts signal economic regime
# EMH Link: Macro consumption data is slow-moving — markets don't instantly
#            price this, creating short-term predictability in allocation
# ══════════════════════════════════════════════════════════════════════════════

os.makedirs("output", exist_ok=True)
START = "2015-01-01"

# ── DATA ──────────────────────────────────────────────────────────────────────
print("Downloading data...")

tickers = ["SPY", "XLY", "XLP", "AGG", "GLD"]
raw     = yf.download(tickers, start=START, auto_adjust=True, progress=False)["Close"]
raw     = raw.ffill().dropna()

# Resample to monthly (cleaner signal)
monthly = raw.resample("ME").last()
returns = monthly.pct_change().dropna()

# ── CONSUMER SIGNAL ───────────────────────────────────────────────────────────
# Core idea: XLY (discretionary) vs XLP (staples)
# When consumers spend on wants > needs → risk-on economy
# When staples outperform → consumers are defensive → risk-off
returns["signal_raw"] = returns["XLY"] - returns["XLP"]

# Smooth with 3-month rolling mean (reduces noise)
returns["signal"] = returns["signal_raw"].rolling(3).mean()

# Standardise into a z-score (makes it comparable over time)
returns["signal_z"] = (
    (returns["signal"] - returns["signal"].rolling(12).mean()) /
     returns["signal"].rolling(12).std()
)

returns = returns.dropna()

# ── REGIME CLASSIFICATION ─────────────────────────────────────────────────────
# Risk-On  = discretionary strong (signal above median)
# Risk-Off = staples dominate    (signal below median)
threshold          = returns["signal_z"].median()
returns["risk_on"] = returns["signal_z"] > threshold

# ── FORWARD RETURNS (avoid look-ahead bias) ───────────────────────────────────
returns["fwd_1m"] = returns["SPY"].shift(-1)
returns["fwd_3m"] = returns["SPY"].rolling(3).sum().shift(-3)

# ── DYNAMIC STRATEGY ──────────────────────────────────────────────────────────
# Rule: Risk-On  → 100% SPY exposure
#        Risk-Off → 50% SPY + 30% AGG + 20% GLD (defensive)
def get_strategy_return(row):
    if row["risk_on"]:
        return row["SPY"]                                        # full equity
    else:
        return 0.5*row["SPY"] + 0.3*row["AGG"] + 0.2*row["GLD"]  # defensive

returns["strategy"] = returns.apply(get_strategy_return, axis=1)
returns["buy_hold"] = returns["SPY"]

# ── METRICS ───────────────────────────────────────────────────────────────────
def annualised_return(r):
    r = r.dropna()
    total = (1 + r).prod()
    years = len(r) / 12
    return round((total ** (1/years) - 1) * 100, 2) if years > 0 else 0

def volatility(r):
    return round(r.dropna().std() * np.sqrt(12) * 100, 2)

def sharpe(r, rf=0.05):
    r    = r.dropna()
    exc  = r - rf/12
    std  = exc.std()
    return round((exc.mean() / std) * np.sqrt(12), 2) if std > 0 else 0

def max_drawdown(r):
    r  = r.dropna()
    eq = (1 + r).cumprod()
    dd = (eq - eq.cummax()) / eq.cummax()
    return round(dd.min() * 100, 2)

def var_95(r):
    return round(np.percentile(r.dropna(), 5) * 100, 2)

strat = returns["strategy"].dropna()
bench = returns["buy_hold"].reindex(strat.index).dropna()

print("\n══ STRATEGY vs BUY & HOLD ════════════════════════")
print(f"{'Metric':<22} {'Strategy':>10}  {'Buy & Hold':>10}")
print("─" * 46)
metrics = {
    "Ann. Return":    (annualised_return(strat), annualised_return(bench), "%"),
    "Volatility":     (volatility(strat),        volatility(bench),        "%"),
    "Sharpe Ratio":   (sharpe(strat),            sharpe(bench),            ""),
    "Max Drawdown":   (max_drawdown(strat),       max_drawdown(bench),      "%"),
    "VaR 95% Daily":  (var_95(strat),             var_95(bench),            "%"),
}
for k, (s, b, u) in metrics.items():
    print(f"{k:<22} {str(s)+u:>10}  {str(b)+u:>10}")

# ── QUINTILE ANALYSIS ─────────────────────────────────────────────────────────
# Split signal into 5 buckets — check if stronger signal = better returns
# This is the "alpha test" used in buy-side research
clean = returns[["signal_z", "fwd_1m"]].dropna()
clean["quintile"] = pd.qcut(clean["signal_z"], 5,
                              labels=["Q1\n(Weakest)", "Q2", "Q3", "Q4", "Q5\n(Strongest)"])
quintile_returns = clean.groupby("quintile", observed=True)["fwd_1m"].mean() * 100

# ── REGIME ANALYSIS ───────────────────────────────────────────────────────────
risk_on_ret  = returns.loc[returns["risk_on"],  "SPY"]
risk_off_ret = returns.loc[~returns["risk_on"], "SPY"]

print(f"\n══ REGIME ANALYSIS ════════════════════════════════")
print(f"Risk-On  avg monthly SPY return : {round(risk_on_ret.mean()*100, 2)}%")
print(f"Risk-Off avg monthly SPY return : {round(risk_off_ret.mean()*100, 2)}%")
print(f"Risk-On  volatility             : {round(risk_on_ret.std()*100, 2)}%")
print(f"Risk-Off volatility             : {round(risk_off_ret.std()*100, 2)}%")

